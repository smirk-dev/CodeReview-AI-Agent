              "name": "Unknown",
              "shortDescription": {
                "text": ""
              },
              "fullDescription": {
                "text": ""
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CR0001",
          "level": "note",
          "message": {
            "text": "Using print() for output"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "code.py"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ]
        },
        {
          "ruleId": "CR0002",
          "level": "error",
          "message": {
            "text": "Hardcoded secret or credential detected"
