{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeReview-AI-Agent",
          "version": "1.0.0",
          "informationUri": "https://github.com/smirk-dev/CodeReview-AI-Agent",
          "rules": [
            {
              "id": "CR0001",
              "name": "print_statement",
              "shortDescription": {
                "text": "Using print() for output"
              },
              "fullDescription": {
                "text": "Use logging module for better control"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CR0002",
              "name": "hardcoded_secret",
              "shortDescription": {
                "text": "Hardcoded secret or credential detected"
              },
              "fullDescription": {
                "text": "Hardcoded secret or credential detected"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR0003",
              "name": "insecure_function",
              "shortDescription": {
                "text": "Use of dangerous function (eval/exec/pickle)"
              },
              "fullDescription": {
                "text": "Use of dangerous function (eval/exec/pickle)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR0004",
              "name": "Unknown",
              "shortDescription": {
                "text": ""
              },
              "fullDescription": {
                "text": ""
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CR0005",
              "name": "Unknown",
              "shortDescription": {
                "text": ""
              },
              "fullDescription": {
                "text": ""
              },
              "defaultConfiguration": {
