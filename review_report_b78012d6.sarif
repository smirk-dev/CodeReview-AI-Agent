{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeReview-AI-Agent",
          "version": "1.0.0",
          "informationUri": "https://github.com/smirk-dev/CodeReview-AI-Agent",
          "rules": [
            {
              "id": "CR0001",
              "name": "print_statement",
              "shortDescription": {
                "text": "Using print() for output"
              },
              "fullDescription": {
                "text": "Use logging module for better control"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "CR0002",
              "name": "Unknown",
              "shortDescription": {
                "text": ""
              },
              "fullDescription": {
                "text": ""
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CR0001",
          "level": "note",
          "message": {
            "text": "Using print() for output"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "code.py"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "CR0002",
          "level": "note",
          "message": {
            "text": ""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "code.py"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        }
      ]
    }
  ]
}